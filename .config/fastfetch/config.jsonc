{
  "$schema": "https://github.com",
  "display": {
    "key": {
      "width": 6 // Уменьшаем ширину колонки ключей, так как теперь там только иконки
    }
  },
  "modules": [
    {
      "type": "os",
      "key": "os" // Только логотип NixOS
    },
    {
      "type": "kernel",
      "key": "kl" // Иконка котика для ядра Linux
    },
    {
      "type": "packages",
      "key": "pk" // Коробка для пакетов
    },
    {
      "type": "shell",
      "key": "sh" // Терминальный шелл
    },
    {
      "type": "wm",
      "key": "wm" // Окна (WM)
    },
    {
      "type": "terminal",
      "key": "tm" // Иконка терминала
    },
    {
      "type": "disk",
      "key": "ds" // Жесткий диск
    },
    {
      "type": "colors",
      "symbol": "circle",
      "key": " " // Пробелы сдвигают цветные кругляшки вправо, выравнивая их с текстом
    }
  ]
}

