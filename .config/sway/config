# Default modifier key (Mod4 = Windows/Command key)
set $mod Mod4

# Your preferred terminal emulator
set $term foot

# Preferred application launcher
set $menu fuzzel

# Preferred browser
set $browser firefox

# preferred Screenshot

# Font for window titles
font pango:monospace 8

# --- Цвета Catppuccin Mocha ---
set $rosewater #f5e0dc
set $flamingo  #f2cdcd
set $pink      #f5c2e7
set $mauve     #cba6f7
set $red       #f38ba8
set $maroon    #eba0ac
set $peach     #fab387
set $yellow    #f9e2af
set $green     #a6e3a1
set $teal      #94e2d5
set $sky       #89dceb
set $sapphire  #74c7ec
set $blue      #89b4fa
set $lavender  #b4befe
set $text      #cdd6f4
set $subtext1  #bac2de
set $subtext0  #a6adc8
set $overlay2  #9399b2
set $overlay1  #7f849c
set $overlay0  #6c7086
set $surface2  #585b70
set $surface1  #45475a
set $surface0  #313244
set $base      #1e1e2e
set $mantle    #181825
set $crust     #11111b

# --- Настройки внешнего вида (Gaps и Рамки) ---
default_border pixel 2
default_floating_border pixel 2
gaps inner 5
gaps outer 5

# --- Стили окон в стиле Catppuccin (Исправлено: убраны желтые индикаторы) ---
# class                 border    backgr    text     indicator child_border
client.focused          $mauve    $base     $text    $mauve     $mauve
client.focused_inactive $overlay0 $base     $text    $overlay0  $overlay0
client.unfocused        $surface1 $base     $text    $surface1  $surface1
client.urgent           $red      $base     $text    $red       $red
client.placeholder      $overlay0 $base     $text    $overlay0  $overlay0
client.background       $base


# --- Стандартные обои Sway ---
output * bg /usr/share/backgrounds/sway/Sway_Wallpaper_Blue_1137x700.png fill #1e1e2e

# --- Настройка клавиатуры (RU/EN и Alt+Space) ---
input "type:keyboard" {
    xkb_layout "us,ru"
    xkb_options "grp:alt_space_toggle"
}

# Start a terminal
bindsym --to-code $mod+t exec $term

# Kill focused window
bindsym --to-code $mod+q kill

# Start a browser
bindsym --to-code $mod+w exec $browser

# Start screenshot
bindsym --to-code $mod+shift+s exec ~/.local/bin/screenshot

# Start your launcher
bindsym --release Super_L exec $menu

# Wleave
bindsym $mod+Shift+q exec wleave

# Drag floating windows with holding repo mod and left mouse button
floating_modifier $mod normal

# Exit sway (logs you out of your Wayland session)
bindsym $mod+Shift+e exec swaynav prompt "Exit sway?" "swaymsg exit"

# Move your focus around with $mod + arrow keys
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move the focused window around with $mod + Shift + arrow keys
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Switch to workspace
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4

# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4

# Layout modifiers
bindsym $mod+b splith
bindsym $mod+v splitv
bindsym --to-code $mod+f fullscreen toggle
bindsym $mod+space floating toggle

# Reload the configuration file
bindsym --to-code $mod+alt+c reload

# --- Запуск Waybar вместо стандартной панели ---
bar {
    swaybar_command waybar
}

exec_always autotiling-rs

for_window [title="(?i)authentication"] floating enable, move position center
for_window [title="(?i)авторизация"] floating enable, move position center

exec_always --no-startup-id lxqt-policykit-agent

# Правильный запуск окон паролей и переменных среды в Sway:
exec env QT_QPA_PLATFORM=wayland QT_QPA_PLATFORMTHEME=qt5ct lxqt-policykit-agent

# Переменная для Electron/Vesktop (чтобы он видел Wayland-порталы)
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
