{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 4,
    // Элементы панели: слева, по центру, справа
    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-center": ["clock"],
    "modules-right": ["cpu", "memory", "sway/language"],

    // Настройка отображения рабочих столов
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}",
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": []
        }
    },

    // Отображение текущего языка клавиатуры
    "sway/language": {
        "format": "  {}",
        "format-en": "EN",
        "format-ru": "RU"
    },

    // Часы и дата
    "clock": {
        "format": "  {:%H:%M    %d.%m.%Y}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    // Процессор
    "cpu": {
        "format": "  {usage}%",
        "tooltip": false
    },

    // Оперативная память
    "memory": {
        "format": "  {}%"
    }
}
